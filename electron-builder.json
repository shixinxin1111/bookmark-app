{
  "appId": "com.bookmark-app.desktop",
  "productName": "Bookmark App",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "package.json"],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "build/icon.icns",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ]
  },
  "dmg": {
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
